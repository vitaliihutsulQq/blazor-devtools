@page "/radzen-dialogs"
@inject DialogService DialogService

<PageTitle>Radzen Dialogs</PageTitle>

<h1>Radzen Dialog Repro</h1>

<p>This page reproduces Radzen's service-driven dialog rendering. The dialog subtree should appear in Blazor DevTools even though it is rendered through the Radzen dialog host.</p>

<div class="d-flex flex-wrap gap-2 mb-3">
    <RadzenButton Text="Open component dialog" Click="@OpenComponentDialogAsync" />
    <RadzenButton Text="Open fragment dialog" ButtonStyle="ButtonStyle.Secondary" Click="@OpenFragmentDialogAsync" />
    <RadzenButton Text="Open side dialog" ButtonStyle="ButtonStyle.Info" Click="@OpenSideDialogAsync" />
</div>

<p class="text-muted">Orders: @orders | Show details: @showDetails</p>

@code {
    private int orders = 4;
    private bool showDetails = true;

    private Task OpenComponentDialogAsync()
    {
        return DialogService.OpenAsync<RadzenComponentDialog>(
            "Component dialog",
            new Dictionary<string, object?>
            {
                [nameof(RadzenComponentDialog.OrderCount)] = orders,
                [nameof(RadzenComponentDialog.ShowDetails)] = showDetails
            },
            new DialogOptions { Width = "640px", CloseDialogOnOverlayClick = true });
    }

    private Task OpenFragmentDialogAsync()
    {
        return DialogService.OpenAsync(
            "Fragment dialog",
            dialogService =>
                @<div>
                    <p class="mb-3">This dialog is opened from a RenderFragment and hosts a nested component.</p>
                    <RadzenInlineDialogPanel Count="@orders" Emphasis="@(showDetails ? "High" : "Low")" />
                    <div class="mt-3 d-flex gap-2">
                        <RadzenButton Text="Add order" Click="@(() => orders++)" />
                        <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Light" Click="@(() => dialogService.Close())" />
                    </div>
                </div>,
            new DialogOptions { Width = "600px", CloseDialogOnOverlayClick = true });
    }

    private Task OpenSideDialogAsync()
    {
        return DialogService.OpenSideAsync<RadzenSideDialogContent>(
            "Side dialog",
            new Dictionary<string, object?>
            {
                [nameof(RadzenSideDialogContent.OrderCount)] = orders,
                [nameof(RadzenSideDialogContent.ShowDetails)] = showDetails
            },
            new SideDialogOptions { Position = DialogPosition.Right, ShowMask = true, Width = "500px" });
    }
}
