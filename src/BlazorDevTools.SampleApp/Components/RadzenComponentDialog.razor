@inherits ComponentBase

<section class="p-2">
    <h2 class="h5">Component-based dialog content</h2>
    <p class="text-muted">This dialog component uses a `.razor.cs : ComponentBase` code-behind and should be discoverable in the tree.</p>
    <p class="text-muted">Navigation base URI: @NavigationManager.BaseUri</p>

    <RadzenInlineDialogPanel Count="@OrderCount" Emphasis="@(ShowDetails ? "Detailed" : "Compact")" />
</section>
