<section class="card border-0 shadow-sm">
    <div class="card-body">
        <h2 class="h4">Case @workspace?.CaseNumber</h2>
        <p class="text-muted">Injected service + async lifecycle + nested partial components.</p>

        @if (workspace is null)
        {
            <p>Loading workspace...</p>
        }
        else
        {
            <div class="row g-3">
                <div class="col-lg-6">
                    <DocumentList Documents="@workspace.Documents" IsPinned="@workspace.IsPinned" />
                </div>
                <div class="col-lg-6">
                    <ActivityTimeline Activities="@FilteredActivities" />
                </div>
            </div>
        }
    </div>
</section>
