<section class="card shadow-sm border-0" @attributes="DevToolsMarkerAttributes">
    <div class="card-body">
        <h2 class="h4">Operations dashboard</h2>
        <p class="text-muted">A consumer-owned component tree tracked through the runtime package.</p>

        <div class="row g-3">
            <div class="col-md-6">
                <CascadingValue Name="@ParentComponentCascadeName" Value="ComponentId" IsFixed="true">
                    <ConsumerCard Title="Orders" Count="@Orders" Tone="Success" Visible="true" />
                </CascadingValue>
            </div>

            <div class="col-md-6">
                <CascadingValue Name="@ParentComponentCascadeName" Value="ComponentId" IsFixed="true">
                    <ConsumerCard Title="Alerts" Count="@(AlertsEnabled ? 3 : 0)" Tone="Warning" Visible="@AlertsEnabled" />
                </CascadingValue>
            </div>
        </div>

        @if (InventoryVisible)
        {
            <div class="mt-3">
                <CascadingValue Name="@ParentComponentCascadeName" Value="ComponentId" IsFixed="true">
                    <ConsumerCard Title="Inventory" Count="12" Tone="Info" Visible="true" />
                </CascadingValue>
            </div>
        }
    </div>
</section>

@code {
    [Parameter]
    public int Orders { get; set; }

    [Parameter]
    public bool AlertsEnabled { get; set; }

    [Parameter]
    public bool InventoryVisible { get; set; }
}
